# Copia este archivo a backend/.env y ajusta los valores.
# El .env real está en .gitignore y nunca debe subirse al repositorio.

# --- Base de datos -----------------------------------------------------------
# TLS se exige automáticamente salvo que el host sea local (localhost, postgres, db).
DATABASE_URL=postgresql://guardia:guardia123@localhost:5432/guardia_gt

# --- Seguridad ---------------------------------------------------------------
# En producción genera una clave larga y aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Orígenes autorizados para CORS (JSON o lista separada por comas).
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Datos de demostración ---------------------------------------------------
# POST /seed queda deshabilitado mientras esta variable esté vacía.
# Con un valor definido, hay que enviarlo en la cabecera X-Seed-Token.
SEED_TOKEN=

# --- IA: informe ejecutivo ---------------------------------------------------
# Sin AI_API_KEY, el informe se genera con una plantilla determinista sobre los
# hallazgos reales (nunca datos inventados). Con una clave de OpenRouter, un
# modelo abierto redacta la prosa.
#   1. Crea una cuenta gratuita en https://openrouter.ai y genera una API key.
#   2. Pon la clave aquí y, en AI_MODEL, el slug exacto del modelo libre que uses.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=xiaomi/mimo-v2.5:free

# --- Confirmación de CVEs por versión ----------------------------------------
# Consulta la API pública del NVD a partir del banner del servicio. Desactivada
# por defecto porque el NVD limita las peticiones y puede ralentizar un escaneo.
CVE_LOOKUP_ENABLED=false

# --- Límite de peticiones ----------------------------------------------------
RATE_LIMIT_ENABLED=true

# --- Motor de diagnóstico ----------------------------------------------------
# Permitir el escaneo de direcciones privadas y de loopback. Déjalo en false en
# cualquier despliegue accesible desde internet: habilitarlo convierte la API en
# una sonda hacia la red interna del proveedor.
SCAN_ALLOW_PRIVATE_TARGETS=false
SCAN_MAX_ASSETS=25
SCAN_PORT_TIMEOUT=0.6
SCAN_HOST_BUDGET_SECONDS=8.0
SCAN_MAX_WORKERS=16
SCAN_HOST_CONCURRENCY=4

# --- Frontend ----------------------------------------------------------------
# Debe incluir el esquema (https:// o http://).
VITE_API_URL=http://localhost:8000
