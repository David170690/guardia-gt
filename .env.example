# Copia este archivo a backend/.env y ajusta los valores.
# El .env real está en .gitignore y nunca debe subirse al repositorio.

# --- Base de datos -----------------------------------------------------------
# TLS se exige automáticamente salvo que el host sea local (localhost, postgres, db).
DATABASE_URL=postgresql://guardia:guardia123@localhost:5432/guardia_gt

# --- Seguridad ---------------------------------------------------------------
# En producción genera una clave larga y aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Orígenes autorizados para CORS (JSON o lista separada por comas).
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Datos de demostración ---------------------------------------------------
# POST /seed queda deshabilitado mientras esta variable esté vacía.
# Con un valor definido, hay que enviarlo en la cabecera X-Seed-Token.
SEED_TOKEN=

# --- Motor de diagnóstico ----------------------------------------------------
# Permitir el escaneo de direcciones privadas y de loopback. Déjalo en false en
# cualquier despliegue accesible desde internet: habilitarlo convierte la API en
# una sonda hacia la red interna del proveedor.
SCAN_ALLOW_PRIVATE_TARGETS=false
SCAN_MAX_ASSETS=25
SCAN_PORT_TIMEOUT=0.6
SCAN_HOST_BUDGET_SECONDS=8.0
SCAN_MAX_WORKERS=16
SCAN_HOST_CONCURRENCY=4

# --- Frontend ----------------------------------------------------------------
# Debe incluir el esquema (https:// o http://).
VITE_API_URL=http://localhost:8000
